{
  "position": "bottom",
  "spacing": 0,
  "height": 0,
  "reload_style_on_change": true,
  "layer": "top",
  "custom/separator": {
    "format": ":",
    "interval": "once",
    "tooltip": false
  },
  "modules-left": [
    "group/personal",
    "custom/coinwatch"
  ],
  "modules-center": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-right": [
    "group/system",
    "clock"
  ],
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "tray",
      "custom/separator",
      "custom/notifications",
      "custom/separator",
      "cpu",
      "custom/separator",
      "memory",
      "custom/separator",
      "pulseaudio",
      "battery"
    ]
  },
  "custom/notifications": {
    "exec": "~/.config/waybar/scripts/mako_dnd.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "makoctl mode -t do-not-disturb",
    "tooltip": true
  },
  "custom/claudebar": {
    "exec": "claudebar --tooltip-font 'FantasqueSansM Nerd Font Mono'",
    "return-type": "json",
    "interval": 300,
    "signal": 13,
    "tooltip": true,
    "on-click": "xdg-open https://claude.ai/settings/usage"
  },
  "group/personal": {
    "orientation": "horizontal",
    "modules": [
      "custom/claudebar"
    ]
  },
  "sway/workspaces": {
    "disable-scroll": true
  },
  "tray": {
    "spacing": 10,
    "tooltip": false
  },
  "cpu": {
    "format": "C {usage}%",
    "interval": 2,
    "states": {
      "critical": 90
    }
  },
  "memory": {
    "format": "M {percentage}%",
    "interval": 2,
    "states": {
      "critical": 80
    }
  },
  "battery": {
    "format": ": B {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "tooltip": true,
    "tooltip-format": "{capacity}% - {time}"
  },
  "network": {
    "format-wifi": "wifi {bandwidthDownBits}",
    "format-ethernet": "enth {bandwidthDownBits}",
    "format-disconnected": "no network",
    "interval": 5,
    "tooltip": false
  },
  "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 150,
    "format": "V {volume}%",
    "format-muted": "V Muted",
    "on-click": "pamixer -t",
    "on-click-right": "pavucontrol",
    "tooltip": false
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}"
  },
  "custom/coinwatch": {
    "exec": "~/.config/waybar/scripts/coinwatch.py",
    "return-type": "json",
    "interval": 60,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/coinwatch_open.sh",
    "signal": 8
  }
}
