{
  "position": "bottom",
  "spacing": 0,
  "height": 0,
  "reload_style_on_change": true,
  "layer": "top",
  "custom/separator": {
    "format": ":",
    "interval": "once",
    "tooltip": false
  },
  "custom/launcher": {
    "format": "ム",
    "tooltip": false,
    "on-click": "exec wlogout -p layer-shell"
  },
  "modules-left": [
    "custom/launcher",
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "group/system",
    "clock"
  ],
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "tray",
      "custom/separator",
      "cpu",
      "custom/separator",
      "memory",
      "custom/separator",
      "pulseaudio",
      "custom/separator",
      "battery"
    ]
  },
  "sway/workspaces": {
    "disable-scroll": true
  },
  "sway/window": {
    "max-length": 50
  },
  "tray": {
    "spacing": 10,
    "tooltip": false
  },
  "cpu": {
    "format": "C {usage}%",
    "interval": 2,
    "states": {
      "critical": 90
    }
  },
  "memory": {
    "format": "M {percentage}%",
    "interval": 2,
    "states": {
      "critical": 80
    }
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "tooltip": false
  },
  "network": {
    "format-wifi": "wifi {bandwidthDownBits}",
    "format-ethernet": "enth {bandwidthDownBits}",
    "format-disconnected": "no network",
    "interval": 5,
    "tooltip": false
  },
  "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 150,
    "format": "V {volume}%",
    "format-muted": "V Muted",
    "on-click": "pamixer -t",
    "on-click-right": "pavucontrol",
    "tooltip": false
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}"
  }
}
