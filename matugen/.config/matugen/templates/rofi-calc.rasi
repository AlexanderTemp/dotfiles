* {
    font: "FantasqueSansM Nerd Font Mono 14";
    bg: #{{colors.surface.default.hex_stripped}}99;
    fg: #{{colors.on_surface.default.hex_stripped}}ff;
    accent: #{{colors.primary.default.hex_stripped}}ff;
    muted: #{{colors.on_surface.default.hex_stripped}}73;
    line: #ffffff17;
    selected: #{{colors.primary.default.hex_stripped}}2e;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 640px;
    location: north;
    y-offset: 220px;
    background-color: @bg;
    border: 1px;
    border-color: #ffffff66;
    border-radius: 12px;
}

mainbox {
    children: [ inputbar, message ];
    spacing: 0;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 14px;
    padding: 18px 22px;
}

prompt {
    font: "Symbols Nerd Font Mono 20";
    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    font: "FantasqueSansM Nerd Font Mono 20";
    placeholder: "Calcular";
    placeholder-color: @muted;
    vertical-align: 0.5;
}

message {
    padding: 16px 22px;
    border: 1px 0 0 0;
    border-color: @line;
}

textbox {
    font: "FantasqueSansM Nerd Font Mono Bold 20";
    text-color: @fg;
}

listview {
    lines: 5;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
    padding: 0 10px 10px 10px;
}

element {
    padding: 9px 12px;
    border-radius: 8px;
}

element normal.normal,
element alternate.normal {
    text-color: @muted;
}

element selected.normal {
    background-color: @selected;
    text-color: @fg;
}

element-text {
    text-color: inherit;
}
