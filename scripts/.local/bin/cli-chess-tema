#!/bin/bash
set -euo pipefail

config="$HOME/.config/cli-chess/config.ini"

if [ ! -f "$config" ]; then
    echo "aviso: abrir cli-chess una vez y volver a correr el script" >&2
    exit 0
fi

sed -i \
    -e 's/^show_board_coordinates = .*/show_board_coordinates = False/' \
    -e 's/^show_material_diff_in_unicode = .*/show_material_diff_in_unicode = False/' \
    -e 's/^terminal_color_depth = .*/terminal_color_depth = DEPTH_24_BIT/' \
    "$config"

echo "opciones de cli-chess aplicadas"
