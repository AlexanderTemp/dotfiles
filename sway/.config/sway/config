set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $menu fuzzel
set $browser firefox

set $monitor_primary HDMI-A-1
set $monitor_secondary DVI-D-1

output $monitor_primary pos 0 0
output $monitor_secondary pos -1366 0
output * allow_tearing yes
output * max_render_time off

workspace 9 output $monitor_secondary

exec swayidle -w \
	timeout 3000 'gtklock' \
	timeout 6000 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
	before-sleep 'gtklock'

input type:keyboard {
	xkb_layout "es"
}

input type:touchpad {
	tap enabled
}

gaps horizontal 2
gaps vertical 2
gaps inner 8

default_border pixel 1
default_floating_border pixel 1

include ~/.config/sway/config.d/colors
include ~/.config/sway/config.d/*
include /etc/sway/config.d/*

client.focused $primary $primary #000000 $primary $primary
client.focused_inactive $surface $surface $primary $surface $surface
client.unfocused $surface $surface $primary $surface $surface
