set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $menu fuzzel
set $browser firefox

set $monitor_primary HDMI-A-1
set $monitor_secondary DVI-D-1

output $monitor_primary pos 0 0
output $monitor_secondary pos -1366 0
output * allow_tearing yes
output * max_render_time off

workspace 9 output $monitor_secondary

exec swayidle -w \
	timeout 3000 'gtklock' \
	timeout 6000 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
	before-sleep 'gtklock'

input type:keyboard {
	xkb_layout "es"
}

input type:touchpad {
	tap enabled
}

gaps horizontal 4
gaps vertical 4
gaps inner 10

default_border pixel 1
default_floating_border pixel 1

corner_radius 12
smart_corner_radius enable

blur enable
blur_passes 2
blur_radius 5
blur_noise 0.02
blur_saturation 1.1

shadows enable
shadow_blur_radius 24
shadow_offset 0 6
shadow_color #00000080
shadow_inactive_color #00000050

animation_duration_ms 150
default_dim_inactive 0


layer_effects "waybar" {
    blur enable;
    blur_ignore_transparent enable;
}
layer_effects "notifications" {
    blur enable;
    blur_ignore_transparent enable;
}
layer_effects "launcher" {
    blur enable;
    shadows enable;
    corner_radius 12;
}
layer_effects "rofi" {
    blur enable;
    blur_ignore_transparent enable;
}
layer_effects "logout_dialog" {
    blur enable;
}

# Diálogos de abrir/guardar: GTK dibuja su propia sombra transparente y el blur la convierte en un borde borroso
for_window [app_id="xdg-desktop-portal-gtk"] floating enable, blur disable, shadows disable, resize set 960 640, move position center

include ~/.config/sway/config.d/colors
include ~/.config/sway/config.d/*
include /etc/sway/config.d/*

client.focused #ffffff66 $primary #000000 #ffffff66 #ffffff66
client.focused_inactive #ffffff10 $surface $primary #ffffff10 #ffffff10
client.unfocused #ffffff10 $surface $primary #ffffff10 #ffffff10
